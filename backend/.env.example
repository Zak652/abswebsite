# --------------------------------------------------------------------------
# Django core
# --------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=abs_backend.settings.local

# Required in production. Comma-separated. The production settings file
# (abs_backend/settings/production.py) raises ImproperlyConfigured if empty.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# --------------------------------------------------------------------------
# Database / cache / queue
# --------------------------------------------------------------------------
POSTGRES_DB=abs_db
POSTGRES_USER=abs_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------
# Payments — Flutterwave (hosted checkout for training)
# --------------------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
# HMAC key for webhook signature verification (computed over raw request body
# — see backend/apps/training/views.py).
FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-secret

# --------------------------------------------------------------------------
# Email — Resend
# --------------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=notifications@absplatform.com
RESEND_SALES_EMAIL=sales@absplatform.com
RESEND_ADMIN_EMAIL=admin@absplatform.com

# --------------------------------------------------------------------------
# Auth & cross-service secrets
# --------------------------------------------------------------------------
# Signs the abs_session cookie (JWT). Must match between Django and the
# Next.js middleware (src/middleware.ts).
JWT_SECRET=your-jwt-secret-for-session-cookie

# Public origin of the Next.js frontend. Used for Flutterwave redirect URLs.
FRONTEND_URL=http://localhost:5000

# Shared between Django and the Next.js /api/revalidate route — used for
# on-demand ISR after a CMS publish.
REVALIDATION_SECRET=your-revalidation-secret-shared-with-nextjs
