# syntax=docker/dockerfile:1.7
#
# Production image for the Next.js frontend, built with Next 16's
# `output: "standalone"` so we can ship a tiny runtime instead of the
# full node_modules tree.
#
# Three stages:
#   1. deps    — install npm deps once, cache via lockfile
#   2. builder — run `next build`, produce .next/standalone
#   3. runtime — copy standalone + static, run as non-root

# --------------------------------------------------------------------------
# Stage 1 — dependencies
# --------------------------------------------------------------------------
FROM node:22-alpine AS deps

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# Build dependencies in a separate dir so we don't rebuild when only app
# code changes.
FROM node:22-alpine AS build-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund


# --------------------------------------------------------------------------
# Stage 2 — build
# --------------------------------------------------------------------------
FROM node:22-alpine AS builder

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

WORKDIR /app
COPY --from=build-deps /app/node_modules ./node_modules
COPY . .

# These are inlined into the build at compile time. Real values come from
# the App Platform `envs` map at deploy time — see ../.do/app.yaml.
ARG NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
ARG NEXT_PUBLIC_SITE_URL=https://example.com
ARG NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=$NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY

RUN npm run build


# --------------------------------------------------------------------------
# Stage 3 — runtime
# --------------------------------------------------------------------------
FROM node:22-alpine AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN apk add --no-cache curl \
    && addgroup -S nextjs \
    && adduser  -S -G nextjs nextjs

WORKDIR /app

# .next/standalone bundles only the files actually referenced by the
# server runtime. .next/static + public are served as static assets.
COPY --from=builder --chown=nextjs:nextjs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /app/.next/static     ./.next/static
COPY --from=builder --chown=nextjs:nextjs /app/public           ./public

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:${PORT}/ || exit 1

CMD ["node", "server.js"]
