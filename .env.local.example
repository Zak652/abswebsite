# Frontend env values. Copy to .env.local for local dev.
# Required values are validated at import time by src/lib/env.ts.

# --------------------------------------------------------------------------
# Public (shipped to the browser — never put secrets here)
# --------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:5000

# Flutterwave hosted-checkout init key (public-by-design).
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key

# --------------------------------------------------------------------------
# Server-only (read by Next.js API routes and middleware)
# --------------------------------------------------------------------------
# Must match Django's JWT_SECRET — the middleware verifies abs_session JWTs
# signed by Django.
JWT_SECRET=your-jwt-secret-for-session-cookie

# Shared with Django for on-demand ISR (POST /api/revalidate).
REVALIDATION_SECRET=your-revalidation-secret-shared-with-nextjs

# Used by /api/draft to authorise the preview-link redirect.
DRAFT_MODE_SECRET=your-draft-mode-secret

# Backend origin for the /media/* rewrite. Defaults to http://backend:8000
# inside docker-compose; override for a non-default port.
BACKEND_ORIGIN=http://localhost:8000

# --------------------------------------------------------------------------
# Observability — Sentry
# --------------------------------------------------------------------------
# Browser-side DSN (public by design; safe to expose).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Server-side DSN (used by sentry.server.config.ts + sentry.edge.config.ts).
# Usually the same value as NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Source-map upload (build-time only; required in production CI).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
