# Host-side port mappings for `docker compose up`.
#
# Copy this file to `.env` and override any port that collides with another
# project running on the same Docker host. The values below are the defaults
# used when the variable is unset, so an unmodified `.env` behaves exactly
# like before.
#
# Only the HOST-side port changes — services inside the compose network keep
# talking to each other on their canonical ports (postgres:5432, redis:6379,
# backend:8000), so no other config needs to move.

# Postgres (host -> container 5432)
POSTGRES_HOST_PORT=5432

# Redis (host -> container 6379)
REDIS_HOST_PORT=6379

# Django backend (host -> container 8000)
# When you change this, the browser-facing NEXT_PUBLIC_API_URL automatically
# follows it, so the Next.js app keeps reaching the API.
BACKEND_HOST_PORT=8000

# Next.js frontend (host -> container 5000)
FRONTEND_HOST_PORT=5000

# Postgres credentials (used by the postgres service and read by Django via
# backend/.env). Override only if the other project also uses `abs_db`.
# POSTGRES_DB=abs_db
# POSTGRES_USER=abs_user
# POSTGRES_PASSWORD=abs_dev_password

# Shared between Django and the Next.js middleware for session cookies.
# JWT_SECRET=dev-jwt-secret

# Prefix for container names (abs_postgres, abs_redis, ...). Override only
# when running TWO copies of *this same project* on the same Docker host —
# Docker requires container names to be globally unique. Pair with
# `docker compose -p <name>` (or COMPOSE_PROJECT_NAME) so the second copy
# gets its own networks and volumes too. Example for a second instance:
#   CONTAINER_PREFIX=abs2
#   COMPOSE_PROJECT_NAME=abswebsite2
# CONTAINER_PREFIX=abs
